<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SATYAM | Bidder Verification</title>

    <link rel="stylesheet" href="styles.css">

    <style>
        .page-wrap {
            max-width: 1400px;
            margin: 0 auto;
            padding: 30px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            gap: 20px;
        }

        .page-header h1 {
            margin: 0;
        }

        .page-header p {
            margin: 6px 0 0;
            opacity: 0.7;
        }

        .header-actions {
            display: flex;
            gap: 10px;
        }

        .metrics {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin-bottom: 25px;
        }

        .metric-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
        }

        .metric-label {
            color: #64748b;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .metric-value {
            font-size: 30px;
            font-weight: 700;
            color: #0f2747;
            margin-top: 8px;
        }

        .content-grid {
            display: grid;
            grid-template-columns: 380px 1fr;
            gap: 22px;
        }

        .card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 24px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
        }

        .card h2 {
            margin-top: 0;
            color: #0f2747;
            font-size: 20px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            color: #475569;
            margin-bottom: 7px;
            text-transform: uppercase;
        }

        .form-group input {
            width: 100%;
            box-sizing: border-box;
            padding: 11px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
        }

        .form-group input:focus {
            border-color: #173b68;
            box-shadow: 0 0 0 3px rgba(23, 59, 104, 0.1);
        }

        .full-btn {
            width: 100%;
            margin-top: 5px;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding: 13px;
            background: #f8fafc;
            color: #475569;
            font-size: 12px;
            text-transform: uppercase;
            border-bottom: 1px solid #e2e8f0;
        }

        td {
            padding: 14px 13px;
            border-bottom: 1px solid #edf2f7;
            font-size: 14px;
            color: #334155;
        }

        tr:hover {
            background: #f8fafc;
        }

        .status {
            display: inline-flex;
            padding: 5px 9px;
            border-radius: 20px;
            background: #ecfdf5;
            color: #047857;
            font-size: 12px;
            font-weight: 700;
        }

        .empty {
            text-align: center;
            padding: 35px;
            color: #64748b;
        }

        .message {
            margin-top: 12px;
            font-size: 13px;
            font-weight: 600;
        }

        .success {
            color: #047857;
        }

        .error {
            color: #b91c1c;
        }

        .api-status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 13px;
            color: #64748b;
        }

        .api-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #94a3b8;
        }

        .api-dot.online {
            background: #16a34a;
        }

        .api-dot.offline {
            background: #dc2626;
        }

        @media (max-width: 1000px) {
            .metrics {
                grid-template-columns: repeat(2, 1fr);
            }

            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {
            .page-wrap {
                padding: 18px;
            }

            .metrics {
                grid-template-columns: 1fr;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>

<body>

<div class="page-wrap">

    <!-- HEADER -->
    <div class="page-header">

        <div>
            <h1>Bidder Verification</h1>
            <p>Register and verify bidder information for GeM procurement.</p>
        </div>

        <div class="header-actions">

            <div class="api-status">
                <span id="apiDot" class="api-dot"></span>
                <span id="apiText">Checking backend...</span>
            </div>

            <button class="btn btn-secondary" onclick="goBack()">
                ← Command Center
            </button>

        </div>

    </div>


    <!-- METRICS -->
    <div class="metrics">

        <div class="metric-card">
            <div class="metric-label">Total Bidders</div>
            <div class="metric-value" id="totalBidders">0</div>
        </div>

        <div class="metric-card">
            <div class="metric-label">GST Records</div>
            <div class="metric-value" id="gstRecords">0</div>
        </div>

        <div class="metric-card">
            <div class="metric-label">PAN Records</div>
            <div class="metric-value" id="panRecords">0</div>
        </div>

        <div class="metric-card">
            <div class="metric-label">Udyam Records</div>
            <div class="metric-value" id="udyamRecords">0</div>
        </div>

    </div>


    <!-- MAIN CONTENT -->
    <div class="content-grid">

        <!-- ADD BIDDER -->
        <div class="card">

            <h2>Add New Bidder</h2>

            <form id="bidderForm">

                <div class="form-group">
                    <label for="companyName">Company Name</label>
                    <input
                        type="text"
                        id="companyName"
                        placeholder="Enter company name"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="gstin">GSTIN</label>
                    <input
                        type="text"
                        id="gstin"
                        placeholder="Enter GSTIN"
                    >
                </div>

                <div class="form-group">
                    <label for="pan">PAN Number</label>
                    <input
                        type="text"
                        id="pan"
                        placeholder="Enter PAN number"
                    >
                </div>

                <div class="form-group">
                    <label for="udyam">Udyam Number</label>
                    <input
                        type="text"
                        id="udyam"
                        placeholder="Enter Udyam registration number"
                    >
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input
                        type="email"
                        id="email"
                        placeholder="Enter bidder email"
                    >
                </div>

                <button
                    type="submit"
                    class="btn btn-primary full-btn"
                    id="addBtn"
                >
                    + Add Bidder
                </button>

                <div id="formMessage" class="message"></div>

            </form>

        </div>


        <!-- BIDDER TABLE -->
        <div class="card">

            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">

                <div>
                    <h2 style="margin-bottom:4px;">Registered Bidders</h2>
                    <div style="font-size:13px; color:#64748b;">
                        Live data from SATYAM backend
                    </div>
                </div>

                <button
                    class="btn btn-secondary"
                    onclick="loadBidders()"
                >
                    ↻ Refresh
                </button>

            </div>


            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Company</th>
                            <th>GSTIN</th>
                            <th>PAN</th>
                            <th>Udyam</th>
                            <th>Email</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody id="bidderTableBody">

                        <tr>
                            <td colspan="7" class="empty">
                                Loading bidders...
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<script src="app.js"></script>

<script>

const API_BASE = "http://127.0.0.1:8000";


/* Escape HTML */
function escapeHTML(value) {

    if (value === null || value === undefined) {
        return "";
    }

    return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}


/* Check backend */
async function checkBackend() {

    const dot = document.getElementById("apiDot");
    const text = document.getElementById("apiText");

    try {

        const response = await fetch(
            `${API_BASE}/api/health`
        );

        if (!response.ok) {
            throw new Error("Backend unavailable");
        }

        dot.className = "api-dot online";
        text.textContent = "Backend Online";

    } catch (error) {

        dot.className = "api-dot offline";
        text.textContent = "Backend Offline";

    }
}


/* Load bidders */
async function loadBidders() {

    const tableBody =
        document.getElementById("bidderTableBody");

    tableBody.innerHTML = `
        <tr>
            <td colspan="7" class="empty">
                Loading bidders...
            </td>
        </tr>
    `;

    try {

        const response = await fetch(
            `${API_BASE}/api/bidders`
        );

        if (!response.ok) {
            throw new Error("Failed to load bidders");
        }

        const bidders = await response.json();

        console.log("Bidders:", bidders);

        updateMetrics(bidders);

        if (!Array.isArray(bidders) || bidders.length === 0) {

            tableBody.innerHTML = `
                <tr>
                    <td colspan="7" class="empty">
                        No bidders found. Add your first bidder.
                    </td>
                </tr>
            `;

            return;
        }


        tableBody.innerHTML = bidders.map(bidder => `

            <tr>

                <td>
                    ${escapeHTML(bidder.id)}
                </td>

                <td>
                    <strong>
                        ${escapeHTML(bidder.company_name)}
                    </strong>
                </td>

                <td>
                    ${escapeHTML(bidder.gstin || "—")}
                </td>

                <td>
                    ${escapeHTML(
                        bidder.pan ||
                        bidder.pan_number ||
                        "—"
                    )}
                </td>

                <td>
                    ${escapeHTML(bidder.udyam_number || "—")}
                </td>

                <td>
                    ${escapeHTML(bidder.email || "—")}
                </td>

                <td>
                    <span class="status">
                        REGISTERED
                    </span>
                </td>

            </tr>

        `).join("");


    } catch (error) {

        console.error(error);

        tableBody.innerHTML = `
            <tr>
                <td colspan="7" class="empty error">
                    Unable to connect to SATYAM backend.
                    <br><br>
                    Make sure FastAPI is running on port 8000.
                </td>
            </tr>
        `;

    }
}


/* Update metrics */
function updateMetrics(bidders) {

    const total = bidders.length;

    const gst = bidders.filter(
        bidder =>
            bidder.gstin &&
            bidder.gstin.trim() !== ""
    ).length;

    const pan = bidders.filter(
        bidder =>
            (
                bidder.pan ||
                bidder.pan_number
            ) &&
            (
                bidder.pan ||
                bidder.pan_number
            ).trim() !== ""
    ).length;

    const udyam = bidders.filter(
        bidder =>
            bidder.udyam_number &&
            bidder.udyam_number.trim() !== ""
    ).length;


    document.getElementById("totalBidders").textContent = total;
    document.getElementById("gstRecords").textContent = gst;
    document.getElementById("panRecords").textContent = pan;
    document.getElementById("udyamRecords").textContent = udyam;
}


/* Add bidder */
document
    .getElementById("bidderForm")
    .addEventListener("submit", async function(event) {

        event.preventDefault();


        const companyName =
            document.getElementById("companyName").value.trim();

        const gstin =
            document.getElementById("gstin").value.trim();

        const pan =
            document.getElementById("pan").value.trim();

        const udyam =
            document.getElementById("udyam").value.trim();

        const email =
            document.getElementById("email").value.trim();


        const button =
            document.getElementById("addBtn");

        const message =
            document.getElementById("formMessage");


        message.textContent = "";
        message.className = "message";


        if (!companyName) {

            message.textContent =
                "Company name is required.";

            message.classList.add("error");

            return;
        }


        button.disabled = true;
        button.textContent = "Adding bidder...";


        try {

            const response = await fetch(
                `${API_BASE}/api/bidders`,
                {
                    method: "POST",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify({

                        company_name: companyName,

                        gstin: gstin,

                        pan: pan,

                        udyam_number: udyam,

                        email: email

                    })
                }
            );


            const data = await response.json();

            console.log("Add bidder response:", data);


            if (!response.ok) {

                throw new Error(
                    data.detail ||
                    data.message ||
                    "Failed to add bidder"
                );
            }


            message.textContent =
                "Bidder added successfully.";

            message.classList.add("success");


            document
                .getElementById("bidderForm")
                .reset();


            await loadBidders();


        } catch (error) {

            console.error(error);

            message.textContent =
                error.message ||
                "Unable to add bidder.";

            message.classList.add("error");

        } finally {

            button.disabled = false;
            button.textContent = "+ Add Bidder";

        }

    });


/* Navigation */
function goBack() {

    window.location.href =
        "02_commandcenter.html";

}


/* Initial load */
document.addEventListener("DOMContentLoaded", function() {

    checkBackend();

    loadBidders();

});


/* Auto refresh */
setInterval(loadBidders, 30000);

</script>

</body>
</html>
