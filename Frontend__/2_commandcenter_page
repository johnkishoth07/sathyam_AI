                    </div>

                </div>


                <!-- TENDERS -->

                <div class="card metric">

                    <div>

                        <div class="label">
                            ACTIVE TENDERS
                        </div>

                        <div
                            class="value"
                            id="tenderCount">

                            —

                        </div>

                    </div>

                    <div class="iconbox">
                        ⌕
                    </div>

                </div>


                <!-- DOCUMENTS -->

                <div class="card metric">

                    <div>

                        <div class="label">
                            DOCUMENTS
                        </div>

                        <div
                            class="value"
                            id="documentCount">

                            —

                        </div>

                    </div>

                    <div class="iconbox">
                        ▣
                    </div>

                </div>


                <!-- AUDIT -->

                <div class="card metric">

                    <div>

                        <div class="label">
                            AUDIT EVENTS
                        </div>

                        <div
                            class="value"
