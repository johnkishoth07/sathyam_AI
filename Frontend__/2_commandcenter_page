    <!-- ================= MAIN ================= -->

    <main class="main">

        <!-- TOP BAR -->

        <header class="topbar">

            <h1>
                Command Center
            </h1>

            <div class="user">

                <div class="avatar">
                    SO
                </div>

                Procurement Officer

            </div>

        </header>


        <!-- ================= CONTENT ================= -->

        <div class="content">


            <!-- HERO -->

            <div class="hero">

                <h2>
